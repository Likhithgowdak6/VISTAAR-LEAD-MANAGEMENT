NODE_ENV=development
PORT=5001
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://localhost:27017/wam_crm_ai?replicaSet=rs0
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Reverse proxies in front of the app. Keep 0 for local dev; set to the real
# hop count in production or IP-based rate limits will see the proxy address.
TRUST_PROXY_HOPS=0
# Per-IP requests per minute across the whole API. 0 disables the limiter.
API_RATE_LIMIT_PER_MINUTE=300
REALTIME_OUTBOX_POLL_INTERVAL_MS=1000
REALTIME_OUTBOX_BATCH_SIZE=100

BCRYPT_ROUNDS=12
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_BYTES=64
REFRESH_TOKEN_TTL_DAYS=30

# Field-level encryption
ENCRYPTION_KEY_CURRENT_VERSION=1
ENCRYPTION_KEY_V1=

# Deterministic contact lookup (blind index) for inbound WhatsApp dedup.
# Base64, decodes to at least 16 bytes. Stable value: never rotate or lookups orphan.
CONTACT_LOOKUP_HMAC_KEY=

SEED_ORGANIZATION_NAME=Vistaar Media
SEED_ORGANIZATION_SLUG=vistaar-media
SEED_SUPER_ADMIN_NAME=Vistaar Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=replace-with-minimum-12-character-password

# WhatsApp provider controls
WHATSAPP_PROVIDER=baileys
WHATSAPP_ENABLED=false
WHATSAPP_POC_ACCOUNT_ID=
WHATSAPP_QR_OUTPUT=terminal

# Phase 5 safety
WHATSAPP_ALLOW_DISPOSABLE_POC_ONLY=true
WHATSAPP_SEND_TEXT_POC_ENABLED=false
WHATSAPP_MAX_OUTBOUND_PER_MINUTE=5

# Phase 6: persist inbound WhatsApp messages into the CRM (disposable POC only).
WHATSAPP_PERSIST_INBOUND_ENABLED=false

# Phase 8: deliver queued outbound messages through the live session (disposable POC only).
WHATSAPP_OUTBOUND_DELIVERY_ENABLED=false
WHATSAPP_OUTBOUND_MAX_ATTEMPTS=3
WHATSAPP_OUTBOUND_LEASE_MS=120000
WHATSAPP_OUTBOUND_POLL_INTERVAL_MS=5000

# Test-phase safety net: CSV of digits-only phone numbers. Empty = unrestricted. When
# non-empty, every outbound send on every account (AI or human-authored) must match one of
# these numbers or it is blocked before it reaches the socket.
WHATSAPP_TEST_ALLOWED_NUMBERS=
# Human-like delay window applied before an AI-authored message becomes eligible to send.
WHATSAPP_HUMAN_DELAY_MIN_MS=60000
WHATSAPP_HUMAN_DELAY_MAX_MS=120000
# AI-authored sends are held back during this local-hour window (start === end disables quiet
# hours; default 0/0 is 24/7 sending). Human/staff sends are never delayed by this.
WHATSAPP_QUIET_HOURS_START=0
WHATSAPP_QUIET_HOURS_END=0
WHATSAPP_BUSINESS_TIMEZONE=Asia/Kolkata

# Step-by-step pipeline tracing: one aligned terminal line per stage a message passes through
# (13 of them, provider -> router -> ingestion -> AI brain -> outbound), and a loud `!!! STOPPED`
# line with a reason wherever a message is dropped. Turn it on while you are watching a live
# test; leave it off otherwise — it is noisy and it prints a ~80-character preview of every
# message body. Phone numbers are masked either way. See "Watching a message move through the
# pipeline" in the root README.
WHATSAPP_TRACE_ENABLED=false

# Meta lead-ads sheet import. The runner polls every active lead source on this interval and
# turns new rows into unassigned inbox leads; it never sends anything to the lead. Off until a
# sheet is actually connected. Sheets must be shared as "anyone with the link can view" — no
# Google credentials are used. LEAD_IMPORT_MAX_ROWS_PER_TICK caps how many new rows one source
# imports per tick, so a first backfill of a large sheet cannot monopolise the loop.
LEAD_IMPORT_ENABLED=false
LEAD_IMPORT_POLL_INTERVAL_MS=600000
LEAD_IMPORT_MAX_ROWS_PER_TICK=200

# Meta Lead Ads direct import (Graph API), the sheet-free path: the CRM asks Meta for a lead
# form's leads itself. Off until the client has a Meta app with `leads_retrieval` and a Page
# access token to paste into the dashboard; while false, creating or testing a Meta source is
# refused and the importer skips Meta sources entirely. The Page access token is entered in the
# dashboard and stored encrypted — it does NOT belong in this file or in .env.
# The polling interval and the per-tick row cap above are shared with the sheet importer.
META_LEAD_ADS_ENABLED=false
META_GRAPH_TIMEOUT_MS=15000
META_GRAPH_MAX_PAGES_PER_TICK=10

# Phase 17: AI reply assistant (ADR-005 — draft only, human must review/edit/send; disabled by
# default). Every AI-drafted reply still goes through the normal composer and send button.
# AI_PROVIDER selects the adapter: "anthropic" (needs ANTHROPIC_API_KEY), "grok" (xAI, needs
# XAI_API_KEY from https://console.x.ai), or "groq" (Groq Cloud, needs GROQ_API_KEY from
# https://console.groq.com — not the same company as xAI's Grok). Only the selected provider's
# key is used. Put real keys in your local .env, never in this example file.
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
# AI_MODEL is optional — leave unset to use each provider's default (claude-sonnet-5 for
# anthropic, grok-3-mini for grok, llama-3.3-70b-versatile for groq).
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=300
AI_DRAFT_RATE_LIMIT_PER_HOUR=30
AI_DRAFT_CONTEXT_MESSAGE_COUNT=20

# ai-brain-service: the standalone Python/LangGraph service that runs the qualifying chat,
# drafting, proposal writing, and the won/lost classifier (see ai-brain-service/README.md at the
# project root). Off by default - wam-crm-ai works fine with automation disabled, tags/stages
# just stay manual. AI_BRAIN_SERVICE_KEY must match that service's SERVICE_API_KEY exactly.
AI_BRAIN_ENABLED=false
AI_BRAIN_SERVICE_URL=http://localhost:8091
AI_BRAIN_SERVICE_KEY=
# Must exceed ai-brain-service's LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1). At that service's
# defaults (40s, 1 retry) the floor is ~90s. Only a proposal call ever gets near it.
AI_BRAIN_REQUEST_TIMEOUT_MS=90000

# Nurture sweep: re-engages leads that have gone quiet on day 2/5/9/15 of silence since our last
# outbound message, then marks them cold (automation off, stage untouched) after day 20 with no
# reply. Off by default - also requires WHATSAPP_ENABLED and WHATSAPP_OUTBOUND_DELIVERY_ENABLED
# to actually send, since a nurture nudge is meaningless without a live delivering connection.
NURTURE_ENABLED=false
NURTURE_SWEEP_INTERVAL_MS=1800000
NURTURE_FOLLOWUP_DAYS=2,5,9,15
NURTURE_COLD_AFTER_DAYS=20
# Also the general staleness guard for any AI-authored send stuck in the queue too long (e.g. the
# delivery runner was down) - dropped rather than sent wildly late.
NURTURE_STALE_AFTER_MS=1800000

# The two owner-facing daily jobs, both keyed off DIGEST_HOUR in WHATSAPP_BUSINESS_TIMEZONE:
# the morning handover read at DIGEST_HOUR:00 (re-reads every conversation the owner took over
# on an earlier day and asks the AI what is actually going on), and the digest at DIGEST_HOUR:10
# (one WhatsApp summary of everything waiting on the owner). Off by default - also requires
# WHATSAPP_ENABLED, since both only ever speak to the owner over WhatsApp.
DAILY_JOBS_ENABLED=false
DIGEST_HOUR=9

# The pre-event owner reminder: one WhatsApp message to the owner the day before a WON deal's
# event, so a booking already paid for is never missed. The sweep ticks every few hours and picks
# up events falling inside the next 24 hours, rather than firing at one fixed time - a restart at
# the wrong moment must not cost a shoot its only reminder. Sending exactly once is guaranteed by
# an atomic claim on the conversation, not by the schedule. Off by default - also requires
# WHATSAPP_ENABLED, since the whole output is a WhatsApp message to the owner.
EVENT_REMINDERS_ENABLED=false
EVENT_REMINDER_SWEEP_INTERVAL_MS=14400000
