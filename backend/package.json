{
  "name": "wam-crm-ai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for WAM CRM AI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:super-admin": "tsx src/seed-super-admin.ts",
    "seed:dev-users": "tsx src/scripts/seed-dev-users.ts",
    "verify:indexes": "tsx src/scripts/verify-indexes.ts",
    "migrate:lead-source-indexes": "tsx src/scripts/migrate-lead-source-indexes.ts",
    "backfill:lid-phones": "tsx src/scripts/backfill-lid-phones.ts",
    "generate:encryption-key": "tsx src/scripts/generate-encryption-key.ts",
    "encryption:rotation:dry-run": "tsx src/scripts/key-rotation-dry-run.ts",
    "phase5:create-poc-account": "tsx src/scripts/phase5-create-poc-account.ts",
    "phase5:inspect-session": "tsx src/scripts/phase5-inspect-session.ts",
    "phase5:start-single-session": "tsx src/scripts/phase5-start-single-session.ts",
    "phase5:start-pairing-code": "tsx src/scripts/phase5-start-pairing-code-session.ts",
    "phase5:local-baileys-poc": "tsx src/scripts/phase5-local-baileys-poc.ts",
    "phase5:real-provider-manual": "tsx src/scripts/phase5-real-provider-manual.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hapi/boom": "10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.9"
  }
}
