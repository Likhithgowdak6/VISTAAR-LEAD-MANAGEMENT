<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        SCHEDULE_EXACT_ALARM is REMOVED on purpose.

        @capacitor/local-notifications declares it in its own manifest, and manifest-merge pulls
        it into this app whether or not anything uses it. Nothing here does: the plugin only
        reaches for an exact alarm when a notification is scheduled with `exact: true`
        (LocalNotificationManager.kt, setExactIfPossible), and the reminder scheduler never sets
        it - it uses `allowWhileIdle`, which maps to setAndAllowWhileIdle and fires during Doze
        without the permission.

        Leaving the declaration in place would be asking Google for a permission restricted to
        alarm-clock and calendar apps, which needs a justification at submission and can get a
        release rejected. Reminders are not an alarm clock: they may be deferred by a few
        minutes under battery management, and that is an accepted trade.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
