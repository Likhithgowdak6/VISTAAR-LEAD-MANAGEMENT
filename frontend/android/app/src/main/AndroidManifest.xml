<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        SCHEDULE_EXACT_ALARM is DECLARED, having previously been stripped with tools:node="remove".

        It was removed on the reasoning that a reminder may be a few minutes late under battery
        management and that this was an accepted trade. On a real handset it was not: Android
        batches an inexact alarm with whatever else it decides to wake for, so "remind me at 2:20"
        arrives whenever Doze next relents. An owner who sets a reminder for a call at 2:20 needs
        it at 2:20.

        WITHOUT THIS LINE THE DOWNGRADE IS SILENT, which is the part worth knowing. The plugin
        defaults `isExactNotification` to true and then computes
        `useExact = isExactNotification && canScheduleExactAlarms()`
        (LocalNotificationManager.kt:357). On Android 12+ that second call is false unless this
        permission is both declared and granted, so the schedule call still succeeds and quietly
        becomes setAndAllowWhileIdle. Nothing throws and nothing warns.

        SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM deliberately: USE_EXACT_ALARM is granted
        at install with no prompt, but Google Play restricts it to apps whose core purpose is an
        alarm clock or calendar, and a CRM is neither. This one is user-granted instead - Android
        shows it under "Alarms & reminders" in app settings, and the Reminders screen links
        straight there. Declaring it costs a listing nothing.

        If the owner later revokes it, Android restarts the app and drops every exact alarm it
        had scheduled. That is survivable here: the reconciler reads getPending() before it does
        anything, finds nothing armed, and re-arms on the next sync.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        SET_ALARM lets Vistaar hand a reminder to the phone's own Clock app, so it rings on the
        alarm stream like any other alarm instead of chiming once in the notification shade.

        A NORMAL permission: granted at install, no runtime prompt, nothing for the owner to turn
        on. It does not let this app read or delete the owner's existing alarms - ACTION_SET_ALARM
        only creates, which is also why a reminder cancelled in the CRM cannot take its Clock
        alarm with it. See ClockAlarmPlugin.java.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
        Android 11 filters which other apps a package can see. Without this, resolveActivity()
        for ACTION_SET_ALARM returns null even on a phone with a perfectly good Clock app, and
        the plugin would report Clock alarms as unavailable on every modern handset.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          windowSoftInputMode=adjustResize: the keyboard must RESIZE the window, not slide it
          up over the content. The dashboard is a full-height flex column whose last child is
          the message composer. Panned (the alternative), the keyboard covers the very input
          that was just tapped, and `100dvh` never changes because the viewport did not.
          Resized, dvh shrinks, the thread above gets shorter and the composer stays on screen.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
