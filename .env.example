# Root .env - read by docker-compose only.
#
# This file configures the ai-brain-service CONTAINER. It is not the backend's config: the
# Node app reads backend/.env, and the two are separate on purpose, because the brain runs in
# Docker and the backend usually does not.
#
# Copy to .env and fill in. Never commit the filled-in file.

# Must match AI_BRAIN_SERVICE_KEY in backend/.env exactly, or every call is rejected as
# unauthorized. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_BRAIN_SERVICE_KEY=

# The model the sales agent thinks with: qualifying questions, drafted replies, proposals, and
# the won/lost classifier all run through this one key.
#
#   anthropic  - Claude. The default. Set AI_BRAIN_LLM_API_KEY to an sk-ant-... key.
#   groq       - Groq's OpenAI-compatible endpoint. Free tier is metered at 8,000 tokens per
#                minute, which this agent exceeds in a handful of calls.
#   openai     - OpenAI.
#
# Switching providers is only these three lines; the service handles the rest.
AI_BRAIN_LLM_PROVIDER=anthropic
AI_BRAIN_LLM_API_KEY=
AI_BRAIN_LLM_MODEL=claude-haiku-4-5-20251001

# Optional overrides. Defaults live in ai-brain-service/app/config.py and are documented there.
# Raising the timeout means also raising backend/.env's AI_BRAIN_REQUEST_TIMEOUT_MS, which must
# stay above LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1).
# AI_BRAIN_LLM_TIMEOUT_SECONDS=40
# AI_BRAIN_LLM_MAX_RETRIES=1
# AI_BRAIN_MAX_QUALIFYING_QUESTIONS=6
