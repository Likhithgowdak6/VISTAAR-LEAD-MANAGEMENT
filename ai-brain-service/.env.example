# Only for LangGraph's checkpoint tables ("which step is this conversation
# on"). Leave empty for local dev - conversations paused for approval are
# then forgotten on restart, which is fine while you're testing.
DATABASE_URL=

# A shared secret you make up. wam-crm-ai must send the same value on every
# request in an X-Service-Key header. Leave empty while testing locally.
SERVICE_API_KEY=

# anthropic (default) | groq | openai | any OpenAI-compatible host via LLM_BASE_URL
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# One call's budget, and how many times it may be retried. LLM_TIMEOUT_SECONDS x
# (LLM_MAX_RETRIES + 1) must stay under the caller's AI_BRAIN_REQUEST_TIMEOUT_MS.
LLM_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=1

MAX_QUALIFYING_QUESTIONS=6
